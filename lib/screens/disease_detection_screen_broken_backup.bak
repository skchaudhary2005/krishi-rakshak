import 'dart:convert';
import 'dart:io';

import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:http/http.dart' as http;
import 'package:image/image.dart' as img;
import 'package:image_picker/image_picker.dart';
import 'package:tflite_flutter/tflite_flutter.dart';

import '../language.dart';

class DiseaseDetectionScreen extends StatefulWidget {
  const DiseaseDetectionScreen({super.key});

  @override
  State<DiseaseDetectionScreen> createState() =>
      _DiseaseDetectionScreenState();
}

class _DiseaseDetectionScreenState
    extends State<DiseaseDetectionScreen> {
  final ImagePicker picker = ImagePicker();

  // ============================================================
  // ONLINE BACKEND
  // ============================================================

  static const String backendUrl = 'http://10.85.135.132:5000';

  // ============================================================
  // OFFLINE TFLITE
  // ============================================================

  Interpreter? _interpreter;

  List<String> _classes = [];

  bool modelLoading = true;

  // ============================================================
  // UI STATE
  // ============================================================

  File? image;

  bool analyzing = false;

  String disease = '';
  double confidence = 0;
  String crop = '';

  String severity = '';
  String description = '';
  String treatment = '';
  String prevention = '';
  String farmerAction = '';

  String analysisMode = '';

  // ============================================================
  // INITIALIZE
  // ============================================================

  @override
  void initState() {
    super.initState();
    _loadOfflineModel();
  }

  Future<void> _loadOfflineModel() async {
    try {
      debugPrint('==========================================');
      debugPrint('LOADING OFFLINE TFLITE MODEL');
      debugPrint('==========================================');

      _interpreter = await Interpreter.fromAsset(
        'assets/models/krishi_rakshak.tflite',
      );

      final jsonString = await rootBundle.loadString(
        'assets/classes/classes.json',
      );

      final decoded = jsonDecode(jsonString);

      if (decoded is! List) {
        throw Exception(
          'classes.json must contain a JSON list',
        );
      }

      _classes = decoded
          .map((e) => e.toString())
          .toList();

      final inputTensor =
          _interpreter!.getInputTensor(0);

      final outputTensor =
          _interpreter!.getOutputTensor(0);

      debugPrint('TFLite loaded successfully');
      debugPrint(
        'Input shape: ${inputTensor.shape}',
      );
      debugPrint(
        'Input type: ${inputTensor.type}',
      );
      debugPrint(
        'Output shape: ${outputTensor.shape}',
      );
      debugPrint(
        'Output type: ${outputTensor.type}',
      );
      debugPrint(
        'Classes: ${_classes.length}',
      );

      if (_classes.length != 38) {
        throw Exception(
          'Expected 38 classes but found '
          '${_classes.length}',
        );
      }

      if (mounted) {
        setState(() {
          modelLoading = false;
        });
      }

      debugPrint('OFFLINE MODEL READY');
    } catch (e) {
      debugPrint(
        'OFFLINE MODEL LOAD ERROR: $e',
      );

      if (mounted) {
        setState(() {
          modelLoading = false;
        });

        message(
          'Offline AI model could not be loaded. '
          'Online mode may still work.',
        );
      }
    }
  }

  // ============================================================
  // CAMERA / GALLERY
  // ============================================================

  Future<void> choose(ImageSource source) async {
    try {
      final XFile? picked = await picker.pickImage(
        source: source,
        imageQuality: 90,
      );

      if (picked == null) {
        return;
      }

      if (!mounted) {
        return;
      }

      setState(() {
        image = File(picked.path);

        disease = '';
        confidence = 0;
        crop = '';

        severity = '';
        description = '';
        treatment = '';
        prevention = '';
        farmerAction = '';

        analysisMode = '';
      });
    } catch (e) {
      debugPrint(
        'IMAGE PICK ERROR: $e',
      );

      if (!mounted) {
        return;
      }

      message(
        source == ImageSource.camera
            ? tr(context, 'cameraError')
            : tr(context, 'galleryError'),
      );
    }
  }

  // ============================================================
  // MAIN ANALYZE
  //
  // ONLINE FIRST
  //      ↓
  // ONLINE FAIL
  //      ↓
  // OFFLINE TFLITE
  // ============================================================

  Future<void> analyze() async {
    if (image == null) {
      message(tr(context, 'select'));
      return;
    }

    if (analyzing) {
      return;
    }

    if (!mounted) {
      return;
    }

    setState(() {
      analyzing = true;
      analysisMode = '';
    });

    debugPrint('');
    debugPrint('==========================================');
    debugPrint('KRISHI RAKSHAK AI ANALYSIS');
    debugPrint('==========================================');
    debugPrint('Image: ${image!.path}');

    // ==========================================================
    // TRY ONLINE FIRST
    // ==========================================================

    try {
      await _analyzeOnline();

      if (!mounted) {
        return;
      }

      setState(() {
        analyzing = false;
        analysisMode = 'ONLINE';
      });

      debugPrint(
        'ONLINE ANALYSIS SUCCESS',
      );

      showResult();
      return;
    } catch (e) {
      debugPrint(
        'ONLINE ANALYSIS FAILED',
      );
      debugPrint('$e');
      debugPrint(
        'Switching to OFFLINE TFLite...',
      );
    }

    // ==========================================================
    // FALLBACK OFFLINE
    // ==========================================================

    try {
      await _analyzeOffline();

      if (!mounted) {
        return;
      }

      setState(() {
        analyzing = false;
        analysisMode = 'OFFLINE';
      });

      debugPrint(
        'OFFLINE ANALYSIS SUCCESS',
      );

      showResult();
    } catch (e) {
      debugPrint(
        'OFFLINE ANALYSIS FAILED',
      );
      debugPrint('$e');

      if (!mounted) {
        return;
      }

      setState(() {
        analyzing = false;
      });

      message(
        'AI analysis failed in both online '
        'and offline mode.',
      );
    }
  }

  // ============================================================
  // ONLINE ANALYSIS
  // ============================================================

  Future<void> _analyzeOnline() async {
    final lang =
        LanguageScope.of(context).value;

    final url =
        '$backendUrl/api/predict';

    debugPrint(
      'Trying online backend...',
    );
    debugPrint(
      'Backend: $url',
    );
    debugPrint(
      'Language: $lang',
    );

    final request = http.MultipartRequest(
      'POST',
      Uri.parse(url),
    );

    request.fields['language'] = lang;

    request.files.add(
      await http.MultipartFile.fromPath(
        'image',
        image!.path,
      ),
    );

    final streamedResponse =
        await request.send().timeout(
      const Duration(seconds: 15),
    );

    final response =
        await http.Response.fromStream(
      streamedResponse,
    );

    debugPrint(
      'Online status: ${response.statusCode}',
    );

    debugPrint(
      'Online response: ${response.body}',
    );

    if (response.statusCode != 200) {
      throw Exception(
        'Backend error ${response.statusCode}: '
        '${response.body}',
      );
    }

    final decoded =
        jsonDecode(response.body);

    if (decoded is! Map) {
      throw Exception(
        'Invalid backend response',
      );
    }

    final Map<String, dynamic> data =
        Map<String, dynamic>.from(decoded);

    // ==========================================================
    // HANDLE ERROR RESPONSE
    // ==========================================================

    if (data.containsKey('success') &&
        data['success'] == false) {
      throw Exception(
        data['error']?.toString() ??
            data['message']?.toString() ??
            'Online AI analysis failed',
      );
    }

    // ==========================================================
    // SUPPORT NESTED RESULT
    // ==========================================================

    Map<String, dynamic> result = data;

    if (data['result'] is Map) {
      result = Map<String, dynamic>.from(
        data['result'] as Map,
      );
    }

    if (data['prediction'] is Map) {
      result = Map<String, dynamic>.from(
        data['prediction'] as Map,
      );
    }

    // ==========================================================
    // READ DISEASE
    // ==========================================================

    final detectedDisease =
        result['disease']?.toString() ??
        result['detected_disease']?.toString() ??
        result['class']?.toString() ??
        result['prediction']?.toString() ??
        result['label']?.toString() ??
        'Unknown';

    // ==========================================================
    // READ CONFIDENCE
    // ==========================================================

    double detectedConfidence =
        _toDouble(
          result['confidence'],
        );

    if (detectedConfidence == 0) {
      detectedConfidence =
          _toDouble(
            result['probability'],
          );
    }

    if (detectedConfidence == 0) {
      detectedConfidence =
          _toDouble(
            result['score'],
          );
    }

    // Convert 0-1 → 0-100.
    if (detectedConfidence > 0 &&
        detectedConfidence <= 1) {
      detectedConfidence *= 100;
    }

    // ==========================================================
    // OTHER INFORMATION
    // ==========================================================

    final detectedCrop =
        result['crop']?.toString() ??
        result['plant']?.toString() ??
        '';

    final detectedSeverity =
        result['severity']?.toString() ??
        '';

    final detectedDescription =
        result['description']?.toString() ??
        '';

    final detectedTreatment =
        result['treatment']?.toString() ??
        '';

    final detectedPrevention =
        result['prevention']?.toString() ??
        '';

    final detectedFarmerAction =
        result['farmerAction']?.toString() ??
        result['farmer_action']?.toString() ??
        '';

    if (!mounted) {
      return;
    }

    setState(() {
      disease = detectedDisease;
      confidence = detectedConfidence;
      crop = detectedCrop;

      severity = detectedSeverity;
      description = detectedDescription;
      treatment = detectedTreatment;
      prevention = detectedPrevention;
      farmerAction = detectedFarmerAction;
    });
  }

  // ============================================================
  // OFFLINE TFLITE ANALYSIS
  // ============================================================

  Future<void> _analyzeOffline() async {
    if (_interpreter == null) {
      throw Exception(
        'Offline TFLite model is not available',
      );
    }

    if (_classes.length != 38) {
      throw Exception(
        'Invalid offline class configuration',
      );
    }

    debugPrint(
      'Running local TFLite inference...',
    );

    final bytes =
        await image!.readAsBytes();

    final decodedImage =
        img.decodeImage(bytes);

    if (decodedImage == null) {
      throw Exception(
        'Could not decode selected image',
      );
    }

    // ==========================================================
    // MODEL INPUT
    // [1, 224, 224, 3]
    // ==========================================================

    final resized = img.copyResize(
      decodedImage,
      width: 224,
      height: 224,
      interpolation:
          img.Interpolation.linear,
    );

    // ==========================================================
    // FLOAT32 INPUT
    //
    // Training:
    // rescale = 1./255
    //
    // Therefore:
    // RGB 0-255 → 0-1
    // ==========================================================

    final input = [
      List.generate(
        224,
        (y) => List.generate(
          224,
          (x) {
            final pixel =
                resized.getPixel(x, y);

            return [
              pixel.r.toDouble() / 255.0,
              pixel.g.toDouble() / 255.0,
              pixel.b.toDouble() / 255.0,
            ];
          },
        ),
      ),
    ];

    // ==========================================================
    // OUTPUT
    // [1, 38]
    // ==========================================================

    final output = [
      List<double>.filled(
        38,
        0.0,
      ),
    ];

    _interpreter!.run(
      input,
      output,
    );

    final probabilities =
        output[0];

    // ==========================================================
    // FIND BEST CLASS
    // ==========================================================

    int bestIndex = 0;

    for (int i = 1;
        i < probabilities.length;
        i++) {
      if (probabilities[i] >
          probabilities[bestIndex]) {
        bestIndex = i;
      }
    }

    final bestProbability =
        probabilities[bestIndex];

    if (bestIndex >= _classes.length) {
      throw Exception(
        'Invalid class index: $bestIndex',
      );
    }

    final predictedClass =
        _classes[bestIndex];

    // ==========================================================
    // EXTRACT CROP
    //
    // Apple___Apple_scab
    //       ↓
    // Apple
    // ==========================================================

    final parts =
        predictedClass.split('___');

    final predictedCrop =
        parts.isNotEmpty
            ? parts.first
                .replaceAll('_', ' ')
                .replaceAll(',', '')
            : 'Unknown';

    // ==========================================================
    // STORE RESULT
    // ==========================================================

    if (!mounted) {
      return;
    }

    setState(() {
      disease = predictedClass;

      crop = predictedCrop;

      confidence =
          bestProbability * 100;

      severity = '';
      description = '';
      treatment = '';
      prevention = '';
      farmerAction = '';
    });

    debugPrint(
      '------------------------------------------',
    );
    debugPrint(
      'OFFLINE RESULT',
    );
    debugPrint(
      'Class index: $bestIndex',
    );
    debugPrint(
      'Class: $predictedClass',
    );
    debugPrint(
      'Crop: $predictedCrop',
    );
    debugPrint(
      'Confidence: '
      '${(bestProbability * 100).toStringAsFixed(2)}%',
    );
    debugPrint(
      '------------------------------------------',
    );
  }

  // ============================================================
  // NUMBER PARSER
  // ============================================================

  double _toDouble(dynamic value) {
    if (value == null) {
      return 0;
    }

    if (value is num) {
      return value.toDouble();
    }

    return double.tryParse(
          value.toString(),
        ) ??
        0;
  }

  // ============================================================
  // MESSAGE
  // ============================================================

  void message(String text) {
    if (!mounted) {
      return;
    }

    ScaffoldMessenger.of(context)
        .showSnackBar(
      SnackBar(
        content: Text(text),
      ),
    );
  }

